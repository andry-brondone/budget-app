NODE_ENV=development
PORT=4000

# PostgreSQL — utilisez Neon (https://neon.tech) pour un hébergement gratuit
DATABASE_URL="postgresql://user:password@localhost:5432/budget_app?schema=public"

# Générez des secrets forts, ex: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-to-a-random-32-char-minimum-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-char-secret"

JWT_ACCESS_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=30

FRONTEND_URL=http://localhost:5173

# Mettre à true en production (HTTPS obligatoire pour les cookies "Secure")
COOKIE_SECURE=false
